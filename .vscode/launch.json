{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run: Mooncake WebApi (Watch / Hot Reload)",
            "type": "node-terminal",
            "request": "launch",
            "command": "dotnet watch run --project src/Mooncake.EcommercePlatform.WebApi/Mooncake.EcommercePlatform.WebApi.csproj",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run: Mooncake WebApi (dotnet run)",
            "type": "node-terminal",
            "request": "launch",
            "command": "dotnet run --project src/Mooncake.EcommercePlatform.WebApi/Mooncake.EcommercePlatform.WebApi.csproj",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "C#: Mooncake WebApi (Official VS Code Debugger)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Mooncake.EcommercePlatform.WebApi/bin/Debug/net8.0/Mooncake.EcommercePlatform.WebApi.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Mooncake.EcommercePlatform.WebApi",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "TZ": "Etc/UTC"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        }
    ]
}
