{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "C#: Mooncake WebApi",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Mooncake.EcommercePlatform.WebApi/bin/Debug/net8.0/Mooncake.EcommercePlatform.WebApi.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Mooncake.EcommercePlatform.WebApi",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "TZ": "Etc/UTC"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        }
    ]
}
