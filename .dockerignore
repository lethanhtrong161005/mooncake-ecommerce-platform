# ==============================================================================
# Docker Ignore - Prevent copying unnecessary files into the Docker Image
# ==============================================================================

# Git
.git/
.gitignore

# Compiled outputs
bin/
obj/
TestResults/
**/bin/
**/obj/
**/TestResults/

# IDEs
.vscode/
.idea/
.vs/

# Environments / Docker config
docker/
.env*
docker-compose*.yml
**/.env
**/.env.*
**/appsettings.json
**/appsettings.*.json
!**/appsettings.sample.json

# Logs
logs/
*.log
**/logs/

# Markdown & Docs
*.md
README.md
.agents/

# OS Files
.DS_Store
Thumbs.db

# Misc scripts
setup-solution.sh
tests/
.tools/
