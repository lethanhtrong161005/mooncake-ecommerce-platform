# Copy to .env for `docker compose up -d` from this directory. Backend secrets and the database connection stay in
# src/Mooncake.EcommercePlatform.WebApi/appsettings.json, mounted at runtime.
# Register https://staging.example.com/auth/google/callback with Google.
STG_PUBLIC_ORIGIN=https://staging.example.com

# Bind both containers to loopback; terminate HTTPS at your public proxy.
STG_BIND_ADDRESS=127.0.0.1
