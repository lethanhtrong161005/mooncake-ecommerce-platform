{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Jwt": {
    "Key": "",
    "Issuer": "Mooncake.EcommercePlatform",
    "Audience": "Mooncake.Frontend",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "GoogleOAuth": {
    "ClientId": "",
    "ClientSecret": "",
    "AuthorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
    "RedirectUri": "http://localhost:5173/auth/google/callback",
    "StateLifetimeMinutes": 5
  },
  "Server": {
    "Port": 8089,
    "TimeZone": "Etc/UTC"
  },
  "SupabaseStorage": {
    "ProjectUrl": "https://your-project-ref.supabase.co",
    "PublishableKey": "",
    "SecretKey": "",
    "ContractBucket": "contracts",
    "MaxContractFileBytes": 10485760,
    "SignedUrlLifetimeSeconds": 300
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseSsl": true,
    "FromEmail": "your-account@gmail.com",
    "Username": "your-account@gmail.com",
    "Password": ""
  }
}
